[
    {
        "name": "query",
        "type": "text",
        "label": "Query",
        "required": true,
        "help": "What you want to do, in plain words. For example `find the work email of a person at a company`."
    },
    {
        "name": "prefer",
        "type": "select",
        "label": "Order by",
        "default": "balanced",
        "options": [
            {
                "label": "Balanced",
                "value": "balanced"
            },
            {
                "label": "Cheapest",
                "value": "cheapest"
            },
            {
                "label": "Most reliable",
                "value": "reliable"
            },
            {
                "label": "Fastest",
                "value": "fastest"
            }
        ]
    },
    {
        "name": "maxPriceUsd",
        "type": "number",
        "label": "Max price (USD)",
        "advanced": true,
        "help": "Leaves out endpoints that cost more than this per call, for example `0.002`."
    },
    {
        "name": "capability",
        "type": "text",
        "label": "Job ID",
        "advanced": true,
        "help": "Only endpoints of this job, for example `people.email.find`."
    },
    {
        "name": "category",
        "type": "text",
        "label": "Category",
        "advanced": true,
        "help": "For example `enrichment`."
    },
    {
        "name": "provider",
        "type": "text",
        "label": "Provider",
        "advanced": true,
        "help": "A provider ID, for example `icypeas`."
    },
    {
        "name": "limit",
        "type": "uinteger",
        "label": "Limit",
        "default": 10,
        "required": true,
        "validate": {
            "min": 1,
            "max": 1000
        },
        "help": "Maximum number of results to return and work with during one execution cycle."
    }
]
