{
    "url": "/v1/runs",
    "method": "POST",
    "body": {
        "endpointId": "job:company.enrich",
        "input": "{{omit(parameters, 'fallback', 'maxCostUsd', 'wait', 'idempotencyKey')}}",
        "idempotencyKey": "{{ifempty(parameters.idempotencyKey, 'make-' + sha256('job:company.enrich' + '|' + createJSON(omit(parameters, 'idempotencyKey')) + '|' + formatDate(now, 'YYYY-MM-DD')))}}",
        "wait": "{{ifempty(parameters.wait, 20)}}",
        "fallback": "{{if(parameters.fallback == false, false, if(parameters.maxCostUsd > 0, parseJSON('{\"enabled\":true,\"maxCostUsd\":' + parameters.maxCostUsd + '}'), true))}}"
    },
    "response": {
        "valid": {
            "condition": "{{body.status != 'failed' && body.status != 'blocked' && body.status != 'stopped'}}",
            "message": "Run {{body.runId}} ended {{body.status}}: [{{ifempty(body.error.code, 'no_code')}}] {{ifempty(body.error.message, 'looot gave no error message.')}}"
        },
        "output": {
            "{{...}}": "{{body}}",
            "createdAt": "{{if(body.createdAt, parseDate(body.createdAt), undefined)}}",
            "startedAt": "{{if(body.startedAt, parseDate(body.startedAt), undefined)}}",
            "completedAt": "{{if(body.completedAt, parseDate(body.completedAt), undefined)}}",
            "companyName": "{{body.normalized.fields.name}}",
            "companyDomain": "{{body.normalized.fields.domain}}",
            "industry": "{{body.normalized.fields.industry}}",
            "size": "{{body.normalized.fields.size}}"
        }
    }
}
