{
  "name": "Add the tech stack of companies in Google Sheets with looot",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:watchRows",
      "version": 2,
      "parameters": {
        "from": "drive",
        "mode": "select",
        "spreadsheetId": "YOUR_SPREADSHEET_ID",
        "sheetId": "Accounts",
        "includesHeaders": true,
        "tableFirstRow": "A1:Z1",
        "limit": 50
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "app#looot:runOperation",
      "version": 1,
      "parameters": {},
      "mapper": {
        "endpointId": "job:company.technographics",
        "inputMode": "json",
        "input": "{\"domain\": \"{{1.`0`}}\"}",
        "fallback": true,
        "maxCostUsd": 0.02,
        "wait": 20
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "openai-gpt-3:CreateCompletion",
      "version": 1,
      "parameters": {},
      "mapper": {
        "select": "chat",
        "model": "gpt-4o-mini",
        "messages": [
          {
            "role": "user",
            "content": "List the technology names in this result as one comma-separated line, most important first, at most 30. Reply with an empty line when there are none.\n\n{{substring(toString(2.result); 0; 8000)}}"
          }
        ],
        "max_tokens": "1200",
        "temperature": "0.2",
        "n_completions": "1",
        "response_format": "text"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    },
    {
      "id": 4,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {},
      "mapper": {
        "mode": "map",
        "spreadsheetId": "{{1.`__SPREADSHEET_ID__`}}",
        "sheetId": "{{1.`__SHEET__`}}",
        "rowNumber": "{{1.`__ROW_NUMBER__`}}",
        "tableFirstRow": "A1:Z1",
        "valueInputOption": "USER_ENTERED",
        "values": {
          "1": "{{3.result}}",
          "2": "{{2.actualCost}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    }
  }
}
