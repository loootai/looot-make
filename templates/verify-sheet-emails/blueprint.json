{
  "name": "Verify email addresses in Google Sheets with looot before you send",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:watchRows",
      "version": 2,
      "parameters": {
        "from": "drive",
        "mode": "select",
        "spreadsheetId": "YOUR_SPREADSHEET_ID",
        "sheetId": "Emails",
        "includesHeaders": true,
        "tableFirstRow": "A1:Z1",
        "limit": 100
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "app#looot:verifyEmail",
      "version": 1,
      "parameters": {},
      "mapper": {
        "email": "{{1.`0`}}",
        "fallback": true,
        "maxCostUsd": 0.01,
        "wait": 20
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {},
      "mapper": {
        "mode": "map",
        "spreadsheetId": "{{1.`__SPREADSHEET_ID__`}}",
        "sheetId": "{{1.`__SHEET__`}}",
        "rowNumber": "{{1.`__ROW_NUMBER__`}}",
        "tableFirstRow": "A1:Z1",
        "valueInputOption": "USER_ENTERED",
        "values": {
          "1": "{{2.emailStatus}}",
          "2": "{{2.deliverable}}",
          "3": "{{2.actualCost}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    }
  }
}
