{
  "name": "Find and verify work emails for new Google Sheets rows with looot",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:watchRows",
      "version": 2,
      "parameters": {
        "from": "drive",
        "mode": "select",
        "spreadsheetId": "YOUR_SPREADSHEET_ID",
        "sheetId": "Leads",
        "includesHeaders": true,
        "tableFirstRow": "A1:Z1",
        "limit": 50
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "app#looot:findWorkEmail",
      "version": 1,
      "parameters": {},
      "mapper": {
        "firstName": "{{1.`0`}}",
        "lastName": "{{1.`1`}}",
        "domain": "{{1.`2`}}",
        "fallback": true,
        "maxCostUsd": 0.05,
        "wait": 20
      },
      "filter": {
        "name": "No email yet",
        "conditions": [
          [
            {
              "a": "{{1.`3`}}",
              "o": "notexist"
            }
          ]
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": null,
      "routes": [
        {
          "flow": [
            {
              "id": 4,
              "module": "app#looot:verifyEmail",
              "version": 1,
              "parameters": {},
              "mapper": {
                "email": "{{2.email}}",
                "fallback": true,
                "maxCostUsd": 0.01,
                "wait": 20
              },
              "filter": {
                "name": "Email found",
                "conditions": [
                  [
                    {
                      "a": "{{2.email}}",
                      "o": "exist"
                    }
                  ]
                ]
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": 0
                }
              }
            },
            {
              "id": 5,
              "module": "google-sheets:updateRow",
              "version": 2,
              "parameters": {},
              "mapper": {
                "mode": "map",
                "spreadsheetId": "{{1.`__SPREADSHEET_ID__`}}",
                "sheetId": "{{1.`__SHEET__`}}",
                "rowNumber": "{{1.`__ROW_NUMBER__`}}",
                "tableFirstRow": "A1:Z1",
                "valueInputOption": "USER_ENTERED",
                "values": {
                  "3": "{{2.email}}",
                  "4": "{{4.emailStatus}}",
                  "5": "{{2.actualCost + 4.actualCost}}"
                }
              },
              "metadata": {
                "designer": {
                  "x": 1200,
                  "y": 0
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 6,
              "module": "google-sheets:updateRow",
              "version": 2,
              "parameters": {},
              "mapper": {
                "mode": "map",
                "spreadsheetId": "{{1.`__SPREADSHEET_ID__`}}",
                "sheetId": "{{1.`__SHEET__`}}",
                "rowNumber": "{{1.`__ROW_NUMBER__`}}",
                "tableFirstRow": "A1:Z1",
                "valueInputOption": "USER_ENTERED",
                "values": {
                  "4": "not_found",
                  "5": "{{2.actualCost}}"
                }
              },
              "filter": {
                "name": "No email found",
                "conditions": [
                  [
                    {
                      "a": "{{2.email}}",
                      "o": "notexist"
                    }
                  ]
                ]
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": 300
                }
              }
            }
          ]
        }
      ],
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    }
  }
}
